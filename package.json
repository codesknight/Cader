{
  "name": "@cader/workspace",
  "version": "0.4.0-dev.17",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "cli:install": "pnpm build && node benchmark/install-cli.mjs",
    "contract:export": "pnpm build && node benchmark/export-cad-contract.mjs",
    "image-test": "pnpm build && node benchmark/run-image-cases.mjs",
    "cader": "pnpm build && node apps/cli/dist/index.js",
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "pnpm build && node --test dist/tests/unit/*.test.js",
    "smoke": "pnpm build && node apps/cli/dist/index.js harness-smoke",
    "doctor": "pnpm build && node apps/cli/dist/index.js doctor",
    "models": "pnpm build && node apps/cli/dist/index.js models",
    "live-smoke": "pnpm build && node apps/cli/dist/index.js live-smoke"
  },
  "devDependencies": {
    "@cader/cli": "workspace:*",
    "@cader/dsh-adapter": "workspace:*",
    "@cader/cad-policy": "workspace:*",
    "@cader/profile": "workspace:*",
    "@types/node": "24.9.0",
    "typescript": "5.9.3",
    "@cader/config": "workspace:*"
  }
}
